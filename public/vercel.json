{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://memoria-qlji.onrender.com/api/:path*"
    },
    {
      "source": "/audio/:path*",
      "destination": "https://memoria-qlji.onrender.com/audio/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}