# Every key is optional — Memoria works without any of them, and gets better with each.

# OpenRouter: Gemma 4 (open weights) on the free tier. Free models allow 20 requests/min and
# 50/day, or 1000/day once the account has bought $10 of credits. Drop ":free" to use paid inference.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FAST_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BACKUP_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Tinker: open-model backup engine. Its OpenAI-compatible API serves Tinker checkpoints,
# so TINKER_MODEL_PATH must be a tinker://…/sampler_weights/… path.
TINKER_API_KEY=
TINKER_MODEL_PATH=
TINKER_MODEL=Qwen/Qwen3.6-35B-A3B

# ElevenLabs: Scribe speech-to-text, read-aloud, voice cloning
ELEVENLABS_API_KEY=
# Default storyteller voice: Grandma Clo (EMuO6fFLrXKOryHzij6K) or George (JBFqnCBsd6RMkjVDRZzb)
ELEVENLABS_VOICE_ID=EMuO6fFLrXKOryHzij6K

# Postgres (Neon) — required
DATABASE_URL=

# Dodo Payments — one-time Lifetime unlock (static checkout link + signed webhook)
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
PUBLIC_URL=https://memoria-family.vercel.app
PORT=3000

# Credit guard — monthly budgets; free families get fallbacks once 90% is used
ELEVENLABS_MONTHLY_CHARS=100000
SCRIBE_MONTHLY_MINUTES=300
ELEVENLABS_VOICE_SLOTS=25
TINKER_MONTHLY_CALLS=400
