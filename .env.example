# Every key is optional — Memoria works without any of them, and gets better with each.

# Backboard: Gemma 4 (open weights, via OpenRouter) + per-person memory/RAG for "Ask"
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openrouter
BACKBOARD_MODEL=google/gemma-4-31b-it

# Tinker: open-model backup engine. Its OpenAI-compatible API serves Tinker checkpoints,
# so TINKER_MODEL_PATH must be a tinker://…/sampler_weights/… path.
TINKER_API_KEY=
TINKER_MODEL_PATH=
TINKER_MODEL=Qwen/Qwen3.6-35B-A3B

# ElevenLabs: Scribe speech-to-text, read-aloud, voice cloning
ELEVENLABS_API_KEY=
# Default storyteller voice: Grandma Clo (EMuO6fFLrXKOryHzij6K) or George (JBFqnCBsd6RMkjVDRZzb)
ELEVENLABS_VOICE_ID=EMuO6fFLrXKOryHzij6K

# Postgres (Neon) — required
DATABASE_URL=

# Dodo Payments — one-time Lifetime unlock (static checkout link + signed webhook)
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
PUBLIC_URL=https://memoria-family.vercel.app
PORT=3000
